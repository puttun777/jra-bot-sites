# キー名のみ。値は Sites の設定（シークレット）またはローカルの .env に入れる。Git に値を書かない。
# 所有者（管理操作が可能）のメールアドレス。カンマ区切り
OWNER_EMAILS=
# 閲覧者（読み取りのみ）のメールアドレス。カンマ区切り
VIEWER_EMAILS=
# MCP / 機械連携用のベアラートークン（32 文字以上）
INGEST_TOKEN=
# Discord Webhook（外部通信が Sites で許可されると確認できるまで未使用）
DISCORD_WEBHOOK_URL=
# ローカル専用: ローカル開発サーバーで使う SQLite のパス
LOCAL_DB_PATH=
# ローカル専用: ローカル開発サーバーの疑似ログイン（本番エントリでは読まない）
LOCAL_DEV_USER_EMAIL=
